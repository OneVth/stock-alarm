# ===== Database =====
# 컨테이너 DB 자격증명 (docker-compose.prod.yml이 DATABASE_URL 자동 조립)
DB_USER=stockalarm_user
DB_PASSWORD=change-me-in-production
DB_NAME=stockalarm

# ===== NextAuth =====
# HTTPS URL 필수 (Secure 쿠키 플래그 조건)
NEXTAUTH_URL="https://v2.stockalarm.co.kr"
# 반드시 아래 명령으로 생성
# openssl rand -base64 32
NEXTAUTH_SECRET="change-me-use-openssl-rand"
# 프록시(cloudflared + nginx) 뒤에서 동작 시 필수
AUTH_TRUST_HOST=true

# ===== Google OAuth =====
# Google Cloud Console에서 승인된 리디렉션 URI에
# https://v2.stockalarm.co.kr/api/auth/callback/google 등록 필요
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== Admin =====
ADMIN_EMAILS=

# ===== External APIs =====
OPENAI_API_KEY=

# ===== Email (Gmail) =====
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ===== Cloudflare Tunnel =====
# Cloudflare Zero Trust 대시보드에서 tunnel 생성 후 발급받은 token
TUNNEL_TOKEN=

# ===== App =====
NEXT_PUBLIC_APP_URL="https://v2.stockalarm.co.kr"
NODE_ENV="production"

# ===== Host =====
# 컨테이너가 호스트 파일에 쓸 때 사용할 UID/GID.
# 라즈베리파이에서 `id -u` / `id -g` 실행 결과를 넣는다.
# tools-py가 src/data/krx-stocks.json을 root 소유로 변경하지 않도록 하기 위함.
HOST_UID=1000
HOST_GID=1000
