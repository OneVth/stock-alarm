// Stock Alarm v2 - Prisma Schema
// 설계 문서: docs/ARCHITECTURE_DESIGN_V2.md 섹션 3

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// User - 사용자
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nickname  String
  image     String?
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts     Alert[]
  alertLogs  AlertLog[]
  files      File[]
  userRoles  UserRole[]
  systemLogs SystemLog[]
}

// ─────────────────────────────────────────────
// Role - 역할 (user, admin)
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  userRoles UserRole[]
}

// ─────────────────────────────────────────────
// UserRole - 사용자-역할 매핑
// ─────────────────────────────────────────────

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

// ─────────────────────────────────────────────
// Alert - 종목 알림
// ─────────────────────────────────────────────

model Alert {
  id             String   @id @default(cuid())
  userId         String
  stockCode      String
  stockName      String
  basePrice      Int
  thresholdUpper Float?
  thresholdLower Float?
  memo           Json?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertLogs AlertLog[]

  @@index([userId, status])
  @@index([userId, stockCode])
}

// ─────────────────────────────────────────────
// AlertLog - 알림 발송 이력
// ─────────────────────────────────────────────

model AlertLog {
  id             String   @id @default(cuid())
  alertId        String?
  userId         String
  stockCode      String
  basePrice      Int
  triggeredPrice Int
  changeRate     Float
  thresholdType  String
  emailSent      Boolean  @default(false)
  createdAt      DateTime @default(now())

  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// File - 파일 업로드 (향후 확장 대비)
// ─────────────────────────────────────────────

model File {
  id        String   @id @default(cuid())
  userId    String
  type      String
  purpose   String
  filename  String
  mimeType  String
  size      Int
  url       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// LogLevel - 로그 레벨
// ─────────────────────────────────────────────

enum LogLevel {
  ERROR
  WARN
  INFO
}

// ─────────────────────────────────────────────
// SystemLog - 시스템 로그
// ─────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel
  category  String
  message   String
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
}
